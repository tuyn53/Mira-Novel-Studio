      "css": ".ds-primary { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px; padding:0 14px; border:1px solid var(--line-strong, #c3d0c7); border-radius:6px; font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:12px; font-weight:600; line-height:1.55; cursor:pointer; } .ds-primary:disabled { opacity:.45; cursor:not-allowed; } .ds-primary { color:var(--on-green, #fff); background:var(--green, #1d5b4c); border-color:var(--green, #1d5b4c); } .ds-primary:hover { background:var(--green-deep, #16483d); } .ds-primary:disabled:hover { background:var(--green, #1d5b4c); } .ds-primary:focus-visible { outline:2px solid var(--green, #1d5b4c); outline-offset:3px; }"
    },
    {
      "name": "细框次按钮",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "透明细框，悬停柔纸底与墨绿边框，无额外位移或过渡。",
      "html": "<button type=\"button\" class=\"ds-secondary\">保留原文</button>",
      "css": ".ds-secondary { display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px; padding:0 14px; border:1px solid var(--line-strong, #c3d0c7); border-radius:6px; font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:12px; font-weight:600; line-height:1.55; cursor:pointer; } .ds-secondary:disabled { opacity:.45; cursor:not-allowed; } .ds-secondary { color:var(--ink, #21302b); background:transparent; } .ds-secondary:hover { border-color:var(--green, #1d5b4c); background:var(--surface-soft, #f6f8f6); } .ds-secondary:disabled:hover { background:inherit; } .ds-secondary:focus-visible { outline:2px solid var(--green, #1d5b4c); outline-offset:3px; }"
    },
    {
      "name": "作品名单行字段",
      "kind": "input",
      "refersTo": "input",
      "description": "43px 开书字段；焦点墨绿边和外环，只读柔纸底。预览片段可编辑仅用于检查样式。",
      "html": "<label class=\"ds-label\" for=\"ds-title\">作品名</label><input class=\"ds-input\" id=\"ds-title\" placeholder=\"给这个故事一个暂时的名字\" />",
      "css": ".ds-label { display:block; margin-bottom:11px; color:var(--ink, #21302b); font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:13px; font-weight:600; line-height:1.55; } .ds-input { width:100%; height:43px; padding:0 13px; color:var(--ink, #21302b); caret-color:var(--green, #1d5b4c); background:var(--surface, #fff); border:1px solid var(--line, #dbe3dd); border-radius:5px; outline:0; font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:13px; line-height:1.55; } .ds-input::placeholder { color:var(--muted, #586b60); } .ds-input:focus { border-color:var(--green, #1d5b4c); } .ds-input:read-only { background:var(--surface-soft, #f6f8f6); } .ds-input:focus-visible { outline:2px solid var(--green, #1d5b4c); outline-offset:3px; }"
    },
    {
      "name": "鼠尾草阶段导航",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "38px 导航行及 180ms 颜色过渡；当前项由路由状态提供。",
      "html": "<nav class=\"ds-nav\" aria-label=\"创作阶段示例\"><a class=\"ds-nav-link\" href=\"#ds-blueprint\">创作蓝图</a><a class=\"ds-nav-link ds-nav-current\" href=\"#ds-write\" aria-current=\"page\">正文写作</a></nav>",
      "css": ".ds-nav { display:grid; width:168px; gap:2px; padding:16px; background:#e7eee8; } .ds-nav-link { display:flex; align-items:center; gap:10px; min-height:38px; padding:0 11px; color:var(--muted, #586b60); border-radius:7px; font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:12.5px; line-height:1.55; text-decoration:none; transition:background .18s ease, color .18s ease; } .ds-nav-link:hover { color:var(--ink, #21302b); background:rgb(255 255 255 / 50%); } .ds-nav-link.ds-nav-current { color:var(--green-deep, #16483d); background:rgb(255 255 255 / 75%); font-weight:600; } .ds-nav-link:focus-visible { outline:2px solid var(--green, #1d5b4c); outline-offset:3px; } :host-context([data-theme=\"dark\"]) .ds-nav { background:#182720; } :host-context([data-theme=\"dark\"]) .ds-nav-link:hover { background:#243c2e; } :host-context([data-theme=\"dark\"]) .ds-nav-link.ds-nav-current { background:#2c4635; } @media (prefers-reduced-motion:reduce) { .ds-nav-link { transition:none!important; } }"
    },
    {
      "name": "上下文小标签",
      "kind": "chip",
      "refersTo": "tag",
      "description": "静态信息标签，没有悬停、按下或键盘焦点状态。",
      "html": "<div class=\"ds-tags\"><span class=\"ds-tag\">写作约定</span><span class=\"ds-tag\">本章章纲</span><span class=\"ds-tag\">已确认设定</span></div>",
      "css": ".ds-tags { display:flex; flex-wrap:wrap; gap:5px; } .ds-tag { padding:3px 6px; color:var(--muted, #586b60); background:var(--surface-soft, #f6f8f6); border:1px solid var(--line, #dbe3dd); border-radius:4px; font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:10px; line-height:1.55; }"
    },
    {
      "name": "白稿表单容器",
      "kind": "card",
      "refersTo": "form-card",
      "description": "白面直角细框、30px 34px 内边距。静态容器没有悬停、焦点或阴影。",
      "html": "<section class=\"ds-card\"><h2 class=\"ds-card-title\">你的故事起点</h2><p class=\"ds-card-copy\">先写下你现在知道的。剩下的，在写作中找到。</p></section>",
      "css": ".ds-card { padding:30px 34px; color:var(--ink, #21302b); background:var(--surface, #fff); border:1px solid var(--line, #dbe3dd); border-radius:0; } .ds-card-title { margin:0; font-family:var(--serif, 'Noto Serif SC', 'Songti SC', STSong, serif); font-size:23px; font-weight:650; line-height:1.55; } .ds-card-copy { margin:10px 0 0; color:var(--muted, #586b60); font-family:var(--ui, 'PingFang SC', 'Microsoft YaHei', sans-serif); font-size:13px; line-height:1.9; }"
    }
  ],
  "narrative": {
    "northStar": "文学期刊编辑部",
    "overview": "Novel Studio 像一间文学期刊编辑部：鼠尾草色的作品导航留在边缘，白色稿件占据主要阅读面，墨绿承载推进动作。细线把目录、文稿与旁注分开，中文衬线赋予书名、章节及正文纸面气质，界面字负责清楚、紧凑的操作。\n\n作品与当前章节是空间的锚点。正文、伴写建议及审阅以相邻栏位组织，专注模式收起目录与伴写栏，让同一稿件获得更多宽度。当前系统面向桌面（1280–1600px）；本地运行仅供浏览示例，Mira 尚未开放真实作品存储与文本生成 SDK，视觉状态不构成能力已接通的承诺。",
    "keyCharacteristics": [
      "白稿为中心，导航与辅助栏退居两侧。",
      "以底色与细分栏线建立层级，常规表面不使用投影。",
      "书名、文稿与叙事提示使用中文衬线，操作标签使用界面字。",
      "墨绿标示推进与选中，赭金和陶红标示状态及需要注意的信息。",
      "浏览示例与待接入边界可见，不伪装保存或生成成功。"
    ],
    "rules": [
      {
        "name": "The 单一推进 Rule",
        "body": "墨绿实底用于当前内容附近的主要推进动作；次要操作使用细边框或文字。",
        "section": "colors"
      },
      {
        "name": "The 双字体分工 Rule",
        "body": "书名、章节与文稿使用衬线栈；导航、按钮、状态和数字使用界面字，保留阅读与操作的区别。",
        "section": "typography"
      },
      {
        "name": "The 细线分栏 Rule",
        "body": "默认用相邻底色、留白与一像素边线表达结构；不把未使用的阴影变量升级为常规卡片效果。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 保持白稿与两侧目录的主次关系，宽度变化优先交给正文。",
      "Do 复用 token 和宿主暗色覆盖，绿色按钮文字使用 on-green。",
      "Do 保留键盘焦点环、禁用透明度与只读软底。",
      "Do 以衬线排书名、章节和正文，以界面字排导航、控件和状态。",
      "Do 明确浏览示例与待接入边界，区分提案与已确认内容。"
    ],
    "donts": [
      "Don't 把窄桌面回退描述为移动端已交付。",
      "Don't 将投影、渐变、漂浮卡片或统计大屏加入细线白稿体系。",
      "Don't 把紧凑上下文标签扩成大胶囊。",
      "Don't 虚构保存、模型在线、作品持久化或生成成功。",
      "Don't 将单个书封装饰色或未消费变量推广为全局规则。"
    ]
  }
}
